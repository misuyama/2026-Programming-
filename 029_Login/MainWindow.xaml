<Window x:Class="_029_Login.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_029_Login"
        mc:Ignorable="d"
        Title="로그인" Height="400" Width="500">
    <Grid Background="LightSteelBlue">
        <StackPanel Margin="50" Background="Aqua">
            <!--1층-->
            <TextBlock Text="로그인" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Padding="10"/>
            
            <!--2층-->
            <StackPanel Orientation="Horizontal" Margin="20">
                <TextBlock Text="Id : " FontSize="18" Width="100" HorizontalAlignment="Right"/>
                <TextBox x:Name="txtid"  FontSize="18" Width="200"/>
                
            </StackPanel>

            <!--3층-->
            <StackPanel Orientation="Horizontal" Margin="20 20 20 10">
                <TextBlock Text="Pw : " FontSize="18" Width="100" HorizontalAlignment="Right"/>
                <PasswordBox x:Name="txtpw" FontSize="18" Width="200"/>

            </StackPanel>

            <!--4층-->
            <StackPanel Orientation="Horizontal" Margin="20">
                <TextBlock Text=" " FontSize="18" Width="100" HorizontalAlignment="Right"/>
                <Button FontSize="18" Width="200" Content="로그인" Padding="20" Click="Button_Click"/> 
               

            </StackPanel>
        </StackPanel>
        
    </Grid>
</Window>
